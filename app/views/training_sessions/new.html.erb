<% content_for :section, "Modo Treino" %>

<div class="flex flex-col w-full gap-md">
  <div class="flex items-center justify-between">
    <span class="tape-badge" style="background: #ffb800; color: black;">⚡ MODO TREINO OFFLINE</span>
  </div>

  <div class="flex flex-col gap-xs">
    <h1 class="screen-title">Checklist Pré-Sessão</h1>
    <p class="screen-desc">Confirme os pontos de segurança antes de subir no skate para garantir um treino seguro.</p>
  </div>

  <%= form_with model: @training_session,
        url: maneuver_training_sessions_path(@maneuver),
        data: { controller: "checklist" },
        class: "flex flex-col gap-sm" do |f| %>

    <label class="check-item done" onclick="this.classList.toggle('done')">
      <div class="check-box-square">
        <span class="material-symbols-outlined text-[16px]">check</span>
      </div>
      <span class="check-text text-[12px] font-bold text-on-surface">Capacete e joelheiras estão bem firmes?</span>
      <%= f.check_box :gear_checked, checked: true, class: "sr-only" %>
    </label>

    <label class="check-item done" onclick="this.classList.toggle('done')">
      <div class="check-box-square">
        <span class="material-symbols-outlined text-[16px]">check</span>
      </div>
      <span class="check-text text-[12px] font-bold text-on-surface">O chão está plano e livre de pedrinhas?</span>
      <%= f.check_box :ground_clear, checked: true, class: "sr-only" %>
    </label>

    <label class="check-item" onclick="this.classList.toggle('done')">
      <div class="check-box-square">
        <span class="material-symbols-outlined text-[16px]">check</span>
      </div>
      <span class="check-text text-[12px] font-bold text-on-surface">Ambiente seguro e livre de perigos ao redor?</span>
      <%= f.check_box :space_safe, class: "sr-only" %>
    </label>

    <div class="flex flex-col gap-sm mt-md">
      <button type="submit" class="tactile-btn-primary" style="background: #ff5a5f; color: black; box-shadow: 0 4px 0 #690005;">
        <span class="material-symbols-outlined text-[24px]">videocam</span>
        <span>Gravar 15s de Vídeo Direto</span>
      </button>

      <button type="submit" class="tactile-btn-primary" style="background: #1f1f23; color: #e3e2e6; box-shadow: 0 4px 0 #121316;">
        <span class="material-symbols-outlined text-[24px]">folder</span>
        <span>Subir Vídeo da Galeria</span>
      </button>

      <%= link_to "Registrar sem enviar vídeo", maneuver_path(@maneuver), class: "secondary-link-btn mt-xs" %>
    </div>
  <% end %>
</div>
