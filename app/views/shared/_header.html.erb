<header class="pt-safe fixed top-0 z-50 w-full bg-[#121316]/95 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.3)]">
  <div class="mx-auto flex h-16 max-w-[980px] items-center justify-between px-4 sm:px-8">
    <!-- Left: Minimalist Menu Button -->
    <div class="flex items-center">
      <button class="flex h-11 w-11 items-center justify-center -ml-2 text-[#e3e2e6] hover:text-[#ffb800] transition-colors" aria-label="Menu">
        <span class="material-symbols-outlined text-[24px]">menu</span>
      </button>
    </div>

    <!-- Right: Help Action Only -->
    <div class="flex items-center">
      <%= link_to new_support_request_path, class: "flex h-10 w-10 items-center justify-center rounded-full bg-[#1f1f23] text-[#d5c4ab] hover:text-[#ffb800] hover:bg-[#292a2d] transition-colors", aria: { label: "Dúvidas e Suporte" } do %>
        <span class="material-symbols-outlined text-[22px]">help</span>
      <% end %>
    </div>
  </div>
</header>
