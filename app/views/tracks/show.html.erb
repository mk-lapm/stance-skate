<% content_for :section, "Trilha" %>

<div class="flex flex-col w-full relative min-h-screen bg-background overflow-hidden font-body text-on-surface">
  <!-- Map Header -->
  <div class="flex items-center justify-between p-sm bg-surface-container-low border-b border-surface-container-highest">
    <div>
      <span class="text-[10px] font-bold text-primary uppercase tracking-wider">MAPA DE RUA · OVERWORLD</span>
      <h1 class="font-display text-headline-md text-on-surface uppercase">DISTRITO 1 · BASE & RUA</h1>
    </div>
    <div class="flex items-center gap-xs">
      <span class="bg-secondary/20 text-secondary border border-secondary px-2 py-0.5 rounded-full text-[11px] font-bold">
        🔥 14 DIAS
      </span>
    </div>
  </div>

  <!-- Map Graphic Viewport -->
  <div class="relative w-full h-[460px] overflow-hidden bg-surface-container-lowest">
    <%= image_tag "skate_overworld_map.jpg", alt: "Mapa de Rua", class: "w-full h-full object-cover" %>

    <!-- Connected Route SVG -->
    <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none">
      <path d="M 22 80 Q 38 64, 52 48 T 66 32 T 78 18" fill="none" stroke="#FFB800" stroke-width="0.8" stroke-dasharray="2,2" class="opacity-60"></path>
    </svg>

    <!-- Node 0.1: Concluído -->
    <%= link_to "#", class: "node-pin completed", style: "top: 80%; left: 22%;", title: "Nó 0.1: Setup" do %>
      <span class="material-symbols-outlined text-[20px]">check</span>
    <% end %>

    <!-- Node 0.2: Concluído -->
    <%= link_to "#", class: "node-pin completed", style: "top: 64%; left: 38%;", title: "Nó 0.2: Equipamento" do %>
      <span class="material-symbols-outlined text-[20px]">check</span>
    <% end %>

    <!-- Node 0.3: Atual Pulsante -->
    <%= link_to maneuver_path(@current_maneuver || 1), class: "node-pin active-node", style: "top: 48%; left: 52%;", title: "Nó 0.3: Queda Controlada" do %>
      <span class="material-symbols-outlined text-[22px]">play_arrow</span>
    <% end %>

    <!-- Node 1.0: Bloqueado -->
    <div class="node-pin locked" style="top: 32%; left: 66%;" title="Nó 1.0: Postura">
      <span class="material-symbols-outlined text-[18px]">lock</span>
    </div>

    <!-- Node 1.1: Bloqueado -->
    <div class="node-pin locked" style="top: 18%; left: 78%;" title="Nó 1.1: Remada">
      <span class="material-symbols-outlined text-[18px]">lock</span>
    </div>

    <!-- Floating Lesson Card -->
    <div class="floating-lesson-card">
      <div class="lesson-info">
        <span class="lesson-step">ZONA 1 · NÓ 0.3 · BASE</span>
        <h4 class="lesson-name">Aprenda a Cair sem se Machucar</h4>
      </div>
      <%= link_to maneuver_path(@current_maneuver || 1), class: "tactile-btn-primary", style: "padding: 8px 12px; font-size: 12px; width: auto;" do %>
        <span>Iniciar Treino</span>
        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
      <% end %>
    </div>
  </div>
</div>
